# 统一换行符：仓库内一律 LF，避免 Windows/macOS 协作时整文件 diff
* text=auto eol=lf

# 明确按文本处理
*.js      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# 二进制文件不做换行转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.zip     binary

# 第三方库与采集样本在 diff/统计中折叠，避免撑爆 PR 视图
src/libs/**     linguist-vendored
tests/fixtures/** linguist-documentation
package-lock.json linguist-generated
